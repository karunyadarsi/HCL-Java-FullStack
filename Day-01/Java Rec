Code: 
1. Using new keyword – Random class

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        Random r = new Random();

        System.out.print("Enter number of digits: ");
        int n = sc.nextInt();

        int min = (int)Math.pow(10, n - 1);
        int max = (int)Math.pow(10, n);

        int otp = min + r.nextInt(max - min);

        System.out.println("Generated OTP: " + otp);
    }
}

2. Without new keyword – Math.random()

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of digits: ");
        int n = sc.nextInt();

        int min = (int)Math.pow(10, n - 1);
        int max = (int)Math.pow(10, n);

        int otp = (int)(min + Math.random() * (max - min));

        System.out.println("Generated OTP: " + otp);
    }
}




